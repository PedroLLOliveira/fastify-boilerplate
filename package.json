{
  "name": "fastify-boilerplate",
  "version": "2.0.0",
  "main": "index.js",
  "bin": {
    "create-fastify-boilerplate": "bin/cli.js"
  },
  "type": "module",
  "files": [
    "bin",
    "lib",
    "docs"
  ],
  "keywords": [
    "fastify",
    "boilerplate",
    "cli",
    "generator"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/v2/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "docs:support-matrix": "node scripts/generate-support-matrix.js",
    "docs:support-matrix:check": "node scripts/generate-support-matrix.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroLLOliveira/fastify-boilerplate.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PedroLLOliveira/fastify-boilerplate/issues"
  },
  "homepage": "https://github.com/PedroLLOliveira/fastify-boilerplate#readme",
  "description": "",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ejs": "^3.1.10",
    "fs-extra": "^11.3.0",
    "kolorist": "^1.8.0",
    "inquirer": "^12.5.2",
    "path": "^0.12.7"
  }
}
